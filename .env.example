# Copy to .env and fill in values. Do not commit .env.

FLASK_ENV=development
SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite:///data/dreamframe.db

# Free text AI (Groq): https://console.groq.com/keys
OPENAI_API_KEY=gsk_your-key-here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-20b

# Free scenic images (Pollinations) — no signup, no credit card
IMAGE_PROVIDER=pollinations
GENERATE_IMAGES=true

USE_MOCK_AI=false

# Optional better free images with a free HF account:
# IMAGE_PROVIDER=huggingface
# HF_TOKEN=hf_your-token-here
